{
    admin off
    # Cloudflare proxies traffic to this server on port 80 (HTTP)
    # Caddy does not need TLS — Cloudflare handles it
    auto_https off
    servers {
        # Trust Cloudflare IP ranges so real client IPs appear in PHP $_SERVER['REMOTE_ADDR']
        # Static list from https://www.cloudflare.com/ips/
        trusted_proxies static 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 104.16.0.0/13 104.24.0.0/14 108.162.192.0/18 131.0.72.0/22 141.101.64.0/18 162.158.0.0/15 172.64.0.0/13 173.245.48.0/20 188.114.96.0/20 190.93.240.0/20 197.234.240.0/22 198.41.128.0/17 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    }
}

# www → non-www redirect (Cloudflare proxies both)
www.sitepulsee.com:80 {
    redir https://sitepulsee.com{uri} permanent
}

sitepulsee.com:80 {
    root * /var/www/sitepulse/public
    encode zstd gzip

    header {
        -Server
        -X-Powered-By
        X-Content-Type-Options  "nosniff"
        X-Frame-Options         "SAMEORIGIN"
        Referrer-Policy         "strict-origin-when-cross-origin"
    }

    @static {
        file
        path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.ttf *.eot *.webp *.avif *.map /build/*
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    php_fastcgi unix//run/php/php8.5-fpm.sock

    file_server

    log {
        output file /var/log/caddy/sitepulse-access.log {
            roll_size 50mb
            roll_keep 5
        }
        format json
    }
}
