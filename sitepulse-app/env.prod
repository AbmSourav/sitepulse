APP_ENV=production
APP_DEBUG=false
APP_URL=https://sitepulsee.com
ASSET_URL=https://sitepulsee.com
APP_KEY=${APP_KEY}

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sitepulse
DB_USERNAME=sitepulse
DB_PASSWORD=${DB_PASSWORD}

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_API_CACHE_DB=2

FILESYSTEM_DISK=local

MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@sitepulsee.com
MAIL_FROM_NAME=SitePulse
RESEND_API_KEY=${RESEND_API_KEY}

GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
GOOGLE_REDIRECT_URI=https://sitepulsee.com/auth/google/callback

PROXY_ENABLED=true
PROXY_URL=http://dc.oxylabs.io
PROXY_PORT=8000
PROXY_USERNAME=${PROXY_USERNAME}
PROXY_PASSWORD=${PROXY_PASSWORD}
