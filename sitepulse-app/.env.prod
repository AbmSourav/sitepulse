APP_ENV=production
APP_DEBUG=false
APP_URL=https://sitepulsee.com
ASSET_URL=https://sitepulsee.com
APP_KEY=${APP_KEY}

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sitepulse
DB_USERNAME=sitepulse
DB_PASSWORD=${DB_PASSWORD}

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@sitepulsee.com
MAIL_FROM_NAME=SitePulse
RESEND_API_KEY=${RESEND_API_KEY}

PROXY_ENABLED=true
PROXY_URL=https://dc.decodo.com
PROXY_PORT=10001
PROXY_USERNAME=${PROXY_USERNAME}
PROXY_PASSWORD=${PROXY_PASSWORD}
